# Tailscale logins allowed to use this server (comma-separated). Only these
# users' devices get in; other people on the tailnet are refused.
GMAIL_MCP_ALLOWED_LOGINS=you@example.com
# Optional: an auth key so the sidecar joins without a login link
# (admin console > Settings > Keys). Leave empty to approve via the link in
# `docker compose logs tailscale` once; the state volume remembers it.
TS_AUTHKEY=
# Tailnet name of this MCP (https://<name>.<tailnet>.ts.net/mcp)
TS_HOSTNAME=gmail
